                    <appui:Text text="Narrower, no selection" class="example-subtitle" />
                    <ui:VisualElement class="example-section" style="height: 200px;">
                        <appui:Sidebar width="180" style="height: 100%;">
                            <appui:SidebarContent>
                                <appui:SidebarSection>
                                    <appui:SidebarItem value="a" label="First" />
                                    <appui:SidebarItem value="b" label="Second" />
                                </appui:SidebarSection>
                            </appui:SidebarContent>
                        </appui:Sidebar>
                    </ui:VisualElement>

                    <!-- Slider -->
                    <appui:Heading text="SLIDER" class="example-title" />
                    <ui:VisualElement class="example-section">
                        <appui:Text text="Default" class="example-subtitle" />
                        <appui:SliderFloat low-value="0" high-value="100" value="50" />
                        <ui:VisualElement style="height: 8px;" />
                        <appui:Text text="Disabled" class="example-subtitle" />
                        <appui:SliderFloat low-value="0" high-value="100" value="50" enabled="false" />
                        <ui:VisualElement style="height: 8px;" />
                        <appui:Text text="Invalid" class="example-subtitle" />
                        <appui:SliderFloat low-value="0" high-value="100" value="50" class="is-invalid" />
                        <ui:VisualElement style="height: 8px;" />
                        <appui:Text text="Track: On" class="example-subtitle" />
                        <appui:SliderFloat low-value="0" high-value="100" value="50" track="On" />
                        <ui:VisualElement style="height: 8px;" />
                        <appui:Text text="Track: Inverted" class="example-subtitle" />
                        <appui:SliderFloat low-value="-100" high-value="100" value="75" track="Inverted" />
                        <ui:VisualElement style="height: 8px;" />
                        <appui:Text text="With input field" class="example-subtitle" />
                        <appui:SliderFloat low-value="-100" high-value="100" value="75" track="On" step="25" show-input-field="true" format-string="#.00" />
                        <appui:Text text="With input field - field bounds widened past the track" class="example-subtitle" />
                        <appui:SliderFloat low-value="0" high-value="100" value="50" track="On" step="1" show-input-field="true" field-high-value="1000" />
                        <appui:Text text="With marks" class="example-subtitle" />
                        <appui:SliderFloat low-value="-100" high-value="100" value="75" track="On" show-marks="true" step="25" />
                        <ui:VisualElement style="height: 8px;" />
                        <appui:Text text="With marks and labels - Restricted Values On Step With Ctrl Key" class="example-subtitle" />
                        <appui:SliderFloat low-value="-100" high-value="100" value="75" track="On" show-marks="true" step="25" show-marks-label="true" restricted-values="CtrlStep" />
                        <appui:Text text="Restricted Values on Step" class="example-subtitle" />
                        <appui:SliderFloat low-value="-100" high-value="100" value="10" step="25" track="On" show-marks="true" show-marks-label="true" restricted-values="Step" />
                        <appui:Text text="Restricted Values on Custom Marks" class="example-subtitle" />
                        <appui:SliderFloat name="restricted-slider" low-value="0" high-value="1" value="0" track="On" show-marks="true" show-marks-label="true" restricted-values="CustomMarks" />
                        <appui:Text text="Restricted Values on Step with Custom Marks" class="example-subtitle" />
                        <appui:SliderFloat name="restricted-step-slider" low-value="0" high-value="1" value="0" track="On" step="0.1" show-marks="true" show-marks-label="true" restricted-values="Step" />
                        <appui:Text text="Non-linear scale" class="example-subtitle" />
                        <appui:Text name="scaled-slider-text" text="Storage Size: 0" />
                        <appui:SliderInt name="scaled-slider" low-value="5" high-value="30" value="5" track="On" display-value-label="Auto"/>
                    </ui:VisualElement>

                    <!-- SplitView -->
                    <appui:Heading text="SPLITVIEW" class="example-title" />
                    <appui:Text text="Horizontal" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:SplitView style="height: 200px;" direction="Horizontal">
                            <appui:Pane style="justify-content: center; align-items: center; width: 50%; min-width: 50px;">
                                <appui:Text text="Pane 1" />
                            </appui:Pane>
                            <appui:Pane style="justify-content: center; align-items: center; width: 50%; min-width: 50px;">
                                <appui:Text text="Pane 2" />
                            </appui:Pane>
