<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI" xsi="http://www.w3.org/2001/XMLSchema-instance" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">

    <appui:Panel name="root-panel" >

        <ui:VisualElement name="root-main">

            <!-- main content -->
            <ui:ScrollView>
                <ui:VisualElement class="example">

                    <!-- Accordion -->
                    <appui:Heading text="ACCORDION" class="example-title" />
                    <appui:Text text="Default" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Accordion>
                            <appui:AccordionItem title="Hello">
                                <appui:Button title="Click Here" />
                            </appui:AccordionItem>
                            <appui:AccordionItem title="Disabled Item" enabled="false">
                                <appui:Button title="Click Here Too" />
                            </appui:AccordionItem>
                            <appui:AccordionItem title="Another Item">
                                <appui:Button title="Click Here Too" />
                            </appui:AccordionItem>
                        </appui:Accordion>
                    </ui:VisualElement>

                    <appui:Text text="Exclusive - Indicator Position : Start" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Accordion is-exclusive="true">
                            <appui:AccordionItem title="Hello" indicator-position="Start">
                                <appui:Button title="Click Here" />
                            </appui:AccordionItem>
                            <appui:AccordionItem title="Disabled Item" enabled="false" indicator-position="Start">
                                <appui:Button title="Click Here Too" />
                            </appui:AccordionItem>
                            <appui:AccordionItem title="Another Item" indicator-position="Start">
                                <appui:Button title="Click Here Too" />
                                <appui:Text text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nulla nec purus feugiat, molestie ipsum et, consequat nibh. Etiam non elit dui. Nullam vel eros sit amet arcu vestibulum accumsan in in leo." />
                            </appui:AccordionItem>
                        </appui:Accordion>
                    </ui:VisualElement>

                    <!-- ActionBar -->
                    <appui:Heading text="ACTIONBAR" class="example-title" />
                    <appui:Text text="Default" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="appui-popover__popover" style="position: relative;"> <!-- Simulate the Popover container -->
                            <ui:VisualElement class="appui-popover__container">
                                <appui:ActionBar>
                                    <appui:ActionButton label="Export" icon="info" quiet="true" />
                                    <appui:ActionButton label="Delete" icon="info" quiet="true" />
                                </appui:ActionBar>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- ActionButton -->
                    <appui:Heading text="ACTIONBUTTON" class="example-title" />
                    <appui:Text text="Sizing" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="example-row">
                            <ui:VisualElement class="example-item">
                                <appui:ActionButton label="Action 1" icon="info" size="Sm" tooltip="Hello" preferred-tooltip-placement="End" />
                            </ui:VisualElement>
                            <ui:VisualElement class="example-item">
                                <appui:ActionButton label="Action 1" icon="info" size="Md" />
                            </ui:VisualElement>
                            <ui:VisualElement class="example-item">
                                <appui:ActionButton label="Action 1" icon="info" size="Lg" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <appui:Text text="With Icon &amp; Label" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:ActionButton label="Action 1" icon="info" />
                    </ui:VisualElement>
                    <appui:Text text="With Trailing Icon &amp; Label" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:ActionButton label="Action 1" trailing-icon="info" />
                    </ui:VisualElement>
                    <appui:Text text="With Icon Only" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:ActionButton icon="info" />
                    </ui:VisualElement>
                    <appui:Text text="Selected" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:ActionButton label="Action 1" icon="info" selected="true" />
                    </ui:VisualElement>
                    <appui:Text text="Selected - Accent" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:ActionButton label="Action 1" icon="info" selected="true" accent="true" />
                    </ui:VisualElement>
                    <appui:Text text="Disabled" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:ActionButton label="Action 1" icon="info" enabled="false" />
                    </ui:VisualElement>
                    <appui:Text text="Selected - Disabled" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:ActionButton label="Action 1" icon="info" enabled="false" selected="true" />
                    </ui:VisualElement>
                    <appui:Text text="Selected - Disabled - Accent" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:ActionButton label="Action 1" icon="info" enabled="false" selected="true" accent="true" />
                    </ui:VisualElement>
                    <appui:Text text="Quiet" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:ActionButton label="Action 1" icon="info" quiet="true" />
                    </ui:VisualElement>
                    <appui:Text text="Quiet - Selected" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:ActionButton label="Action 1" icon="info" quiet="true" selected="true" />
                    </ui:VisualElement>
                    <appui:Text text="Quiet - Selected - Accent" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:ActionButton label="Action 1" icon="info" quiet="true" selected="true" accent="true" />
                    </ui:VisualElement>

                    <!-- ActionGroup -->
                    <appui:Heading text="ACTIONGROUP" class="example-title" />
                    <appui:Text text="Default" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="example-row">
                            <appui:ActionGroup>
                                <appui:ActionButton label="Cut" />
                                <appui:ActionButton label="Copy" />
                                <appui:ActionButton label="Paste" />
                            </appui:ActionGroup>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <appui:Text text="Selectable - Single" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="example-row">
                            <appui:ActionGroup selection-type="Single">
                                <appui:ActionButton label="Left" />
                                <appui:ActionButton label="Center" />
                                <appui:ActionButton label="Right" />
                                <appui:ActionButton label="Justify" />
                            </appui:ActionGroup>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <appui:Text text="Selectable - Multiple" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="example-row">
                            <appui:ActionGroup selection-type="Multiple">
                                <appui:ActionButton label="Option 1" />
                                <appui:ActionButton label="Option 2" />
                                <appui:ActionButton label="Option 3" />
                            </appui:ActionGroup>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <appui:Text text="Overflow" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:SplitView style="height: 100px;">
                            <appui:Pane style="width: 100px;">
                                <appui:ActionGroup compact="true">
                                    <appui:ActionButton label="Option 1" />
                                    <appui:ActionButton label="Option 2" />
                                    <appui:ActionButton label="Option 3" />
                                    <appui:ActionButton label="Option 4" />
                                </appui:ActionGroup>
                            </appui:Pane>
                            <appui:Pane stretch-factor="1" />
                        </appui:SplitView>
                    </ui:VisualElement>

                    <appui:Text text="Overflow - Selectable" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:SplitView style="height: 100px;">
                            <appui:Pane style="width: 100px;">
                                <appui:ActionGroup compact="true" selection-type="Multiple" close-on-selection="false">
                                    <appui:ActionButton label="Option 1" />
                                    <appui:ActionButton label="Option 2" />
                                    <appui:ActionButton label="Option 3" />
                                    <appui:ActionButton label="Option 4" />
                                </appui:ActionGroup>
                            </appui:Pane>
                            <appui:Pane stretch-factor="1" />
                        </appui:SplitView>
                    </ui:VisualElement>

                    <appui:Text text="Overflow - Vertical" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:SplitView direction="Vertical" style="height: 200px;">
                            <appui:Pane style="width: 100px;">
                                <ui:VisualElement style="width: 100%; height: 100%; align-items: flex-start;">
                                    <appui:ActionGroup direction="Vertical" style="max-height: 100%;">
                                        <appui:ActionButton icon="info" />
                                        <appui:ActionButton icon="info" />
                                        <appui:ActionButton icon="info" />
                                        <appui:ActionButton icon="info" />
                                    </appui:ActionGroup>
                                </ui:VisualElement>
                            </appui:Pane>
                            <appui:Pane stretch-factor="1" />
                        </appui:SplitView>
                    </ui:VisualElement>

                    <appui:Text text="Quiet" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="example-row">
                            <appui:ActionGroup quiet="true">
                                <appui:ActionButton label="Cut" quiet="true" />
                                <appui:ActionButton label="Copy" quiet="true" />
                                <appui:ActionButton label="Paste" quiet="true" />
                            </appui:ActionGroup>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <appui:Text text="Justified" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="example-row">
                            <appui:ActionGroup justified="true">
                                <appui:ActionButton label="Cut" />
                                <appui:ActionButton label="Copy" />
                                <appui:ActionButton label="Paste" />
                            </appui:ActionGroup>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <appui:Text text="Justified (Icon only)" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="example-row">
                            <appui:ActionGroup justified="true">
                                <appui:ActionButton icon="info" />
                                <appui:ActionButton icon="info" />
                                <appui:ActionButton icon="info" />
                            </appui:ActionGroup>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <appui:Text text="Compact" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="example-row">
                            <appui:ActionGroup compact="true">
                                <appui:ActionButton label="Cut" />
                                <appui:ActionButton label="Copy" />
                                <appui:ActionButton label="Paste" />
                            </appui:ActionGroup>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <appui:Text text="Compact &amp; Justified" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="example-row">
                            <appui:ActionGroup compact="true" justified="true">
                                <appui:ActionButton label="Cut" />
                                <appui:ActionButton label="Copy" />
                                <appui:ActionButton label="Paste" />
                            </appui:ActionGroup>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <appui:Text text="Compact &amp; Justified (Icon only)" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="example-row">
                            <appui:ActionGroup justified="true" compact="true">
                                <appui:ActionButton icon="info" />
                                <appui:ActionButton icon="info" />
                                <appui:ActionButton icon="info" />
                            </appui:ActionGroup>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <!-- ActionGroup Vertical -->
                    <appui:Text text="Vertical" class="example-subtitle" />
                    <ui:VisualElement class="example-section" style="align-items: flex-start;">
                        <appui:ActionGroup direction="Vertical">
                            <appui:ActionButton label="Cut" />
                            <appui:ActionButton label="Copy" />
                            <appui:ActionButton label="Paste" />
                        </appui:ActionGroup>
                    </ui:VisualElement>
                    <ui:VisualElement class="example-section" style="align-items: flex-start;">
                        <appui:ActionGroup direction="Vertical">
                            <appui:ActionButton label="Copy" />
                        </appui:ActionGroup>
                    </ui:VisualElement>
                    <appui:Text text="Vertical - Quiet" class="example-subtitle" />
                    <ui:VisualElement class="example-section" style="align-items: flex-start;">
                        <appui:ActionGroup direction="Vertical" quiet="true">
                            <appui:ActionButton label="Cut" quiet="true" />
                            <appui:ActionButton label="Copy" quiet="true" />
                            <appui:ActionButton label="Paste" quiet="true" />
                        </appui:ActionGroup>
                    </ui:VisualElement>
                    <ui:VisualElement class="example-section" style="align-items: flex-start;">
                        <appui:ActionGroup direction="Vertical" quiet="true">
                            <appui:ActionButton label="Copy" quiet="true" />
                        </appui:ActionGroup>
                    </ui:VisualElement>
                    <appui:Text text="Vertical - Justified" class="example-subtitle" />
                    <ui:VisualElement class="example-section" style="align-items: flex-start;">
                        <appui:ActionGroup direction="Vertical" justified="true">
                            <appui:ActionButton label="Cut" />
                            <appui:ActionButton label="Copy" />
                            <appui:ActionButton label="Paste" />
                        </appui:ActionGroup>
                    </ui:VisualElement>
                    <appui:Text text="Vertical - Justified (Icon only)" class="example-subtitle" />
                    <ui:VisualElement class="example-section" style="align-items: flex-start;">
                        <appui:ActionGroup direction="Vertical" justified="true">
                            <appui:ActionButton icon="info" />
                            <appui:ActionButton icon="info" />
                            <appui:ActionButton icon="info" />
                        </appui:ActionGroup>
                    </ui:VisualElement>
                    <appui:Text text="Vertical - Compact" class="example-subtitle" />
                    <ui:VisualElement class="example-section" style="align-items: flex-start;">
                        <appui:ActionGroup direction="Vertical" compact="true">
                            <appui:ActionButton label="Cut" />
                            <appui:ActionButton label="Copy" />
                            <appui:ActionButton label="Paste" />
                        </appui:ActionGroup>
                    </ui:VisualElement>
                    <appui:Text text="Vertical - Compact &amp; Justified" class="example-subtitle" />
                    <ui:VisualElement class="example-section" style="align-items: flex-start;">
                        <appui:ActionGroup direction="Vertical" compact="true" justified="true">
                            <appui:ActionButton label="Cut" />
                            <appui:ActionButton label="Copy" />
                            <appui:ActionButton label="Paste" />
                        </appui:ActionGroup>
                    </ui:VisualElement>
                    <appui:Text text="Vertical - Compact &amp; Justified (Icon only)" class="example-subtitle" />
                    <ui:VisualElement class="example-section" style="align-items: flex-start;">
                        <appui:ActionGroup direction="Vertical" justified="true" compact="true">
                            <appui:ActionButton icon="info" />
                            <appui:ActionButton icon="info" />
                            <appui:ActionButton icon="info" />
                        </appui:ActionGroup>
                    </ui:VisualElement>
                    <ui:VisualElement class="example-section" style="align-items: flex-start;">
                        <appui:ActionGroup direction="Vertical" justified="true" compact="true">
                            <appui:ActionButton icon="info" />
                        </appui:ActionGroup>
                    </ui:VisualElement>

                    <!-- Avatar -->
                    <appui:Heading text="AVATAR" class="example-title" />
                    <appui:Text text="Default" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Avatar background-color="#4D70EE" label="MB" auto-label-color="true" />
                    </ui:VisualElement>
                    <appui:Text text="Variants" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="example-row">
                            <ui:VisualElement class="example-item">
                                <appui:Avatar background-color="#4D70EE" variant="Circular" label="MB" auto-label-color="true" />
                            </ui:VisualElement>
                            <ui:VisualElement class="example-item">
                                <appui:Avatar background-color="#4D70EE" variant="Rounded" label="MB" auto-label-color="true" />
                            </ui:VisualElement>
                            <ui:VisualElement class="example-item">
                                <appui:Avatar background-color="#4D70EE" variant="Square" label="MB" auto-label-color="true" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <appui:Text text="Long Text" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Avatar background-color="#4D70EE" label="This is a long text" auto-label-color="true" tooltip="This is a long text" />
                    </ui:VisualElement>
                    <appui:Text text="Sizing" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="example-row">
                            <ui:VisualElement class="example-item">
                                <appui:Avatar size="Sm" background-color="#4D70EE" label="MB" auto-label-color="true" />
                            </ui:VisualElement>
                            <ui:VisualElement class="example-item">
                                <appui:Avatar background-color="#4D70EE" label="MB" auto-label-color="true" />
                            </ui:VisualElement>
                            <ui:VisualElement class="example-item">
                                <appui:Avatar size="Lg" background-color="#4D70EE" label="MB" auto-label-color="true" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <appui:Text text="Outlined" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Avatar background-color="#4D70EE" outline-color="#00FF00" label="MB" auto-label-color="true" />
                    </ui:VisualElement>
                    <appui:Text text="With Icon" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Avatar background-color="#4D70EE">
                            <appui:Icon icon-name="info" style="--unity-image-tint-color: #fff;" />
                        </appui:Avatar>
                    </ui:VisualElement>
                    <appui:Text text="With Custom Picture (By Code)" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Avatar name="avatar-with-picture" outline-color="#4D70EE" background-color="#4D70EE"/>
                    </ui:VisualElement>
                    <appui:Text text="Disabled" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Avatar outline-color="#4D70EE" background-color="#4D70EE" enabled="false" label="MB" auto-label-color="true" />
                    </ui:VisualElement>

                    <!-- AvatarGroup -->
                    <appui:Heading text="AVATARGROUP" class="example-title" />
                    <appui:Text text="Circular - Small Spacing" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:AvatarGroup name="avatar-group-1" variant="Circular" spacing="S" />
                    </ui:VisualElement>
                    <appui:Text text="Circular - Medium Spacing" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:AvatarGroup name="avatar-group-1" variant="Circular" spacing="M" />
                    </ui:VisualElement>
                    <appui:Text text="Circular - Large Spacing" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:AvatarGroup name="avatar-group-1" variant="Circular" spacing="L" />
                    </ui:VisualElement>
                    <appui:Text text="Circular - No overlap" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:AvatarGroup name="avatar-group-1" variant="Circular" spacing="NoOverlap" />
                    </ui:VisualElement>
                    <appui:Text text="Sizing" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:AvatarGroup name="avatar-group-1" size="Sm" spacing="L" />
                        <appui:AvatarGroup name="avatar-group-1" size="Md" spacing="M" />
                        <appui:AvatarGroup name="avatar-group-1" size="Lg" spacing="S" />
                    </ui:VisualElement>
                    <appui:Text text="Max = 2" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:AvatarGroup name="avatar-group-1" max="2" />
                    </ui:VisualElement>
                    <appui:Text text="Custom total" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:AvatarGroup name="avatar-group-1" total="42" spacing="L" />
                    </ui:VisualElement>

                    <!-- Badge -->
                    <appui:Heading text="BADGE" class="example-title" />
                    <appui:Text text="Default" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="badge-container-example">
                            <appui:Badge />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <appui:Text text="Dot variant" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="badge-container-example">
                            <appui:Badge variant="Dot" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <appui:Text text="With content" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="badge-container-example">
                            <appui:Badge>
                                <ui:TextElement text="10" />
                            </appui:Badge>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <appui:Text text="Show Zero" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="badge-container-example">
                            <appui:Badge>
                                <ui:TextElement text="0" />
                            </appui:Badge>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <appui:Text text="Max value" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="badge-container-example">
                            <appui:Badge>
                                <ui:TextElement text="99+" />
                            </appui:Badge>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <appui:Text text="Custom colors" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="badge-container-example">
                            <appui:Badge background-color="#ffcc00" color="#000">
                                <ui:TextElement text="99+" />
                            </appui:Badge>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <appui:Text text="Anchors" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="example-row">
                            <ui:VisualElement class="example-item">
                                <appui:RadioGroup name="h-anchor-badge">
                                    <appui:Radio label="Left" key="Left" emphasized="true" />
                                    <appui:Radio label="Right" key="Right" emphasized="true" />
                                </appui:RadioGroup>
                            </ui:VisualElement>
                            <ui:VisualElement class="example-item">
                                <appui:RadioGroup name="v-anchor-badge">
                                    <appui:Radio label="Top" key="Top" emphasized="true" />
                                    <appui:Radio label="Bottom" key="Bottom" emphasized="true" />
                                </appui:RadioGroup>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="example-row">
                            <ui:VisualElement class="example-item">
                                <ui:VisualElement class="badge-container-example">
                                    <appui:Badge name="badge-1" variant="Default" overlap-type="Rectangular" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="example-item">
                                <ui:VisualElement class="badge-container-example">
                                    <appui:Badge name="badge-2" variant="Dot" overlap-type="Rectangular" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="example-item">
                                <ui:VisualElement class="badge-container-example badge-container-circular-example">
                                    <appui:Badge name="badge-3" variant="Default" overlap-type="Circular"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="example-item">
                                <ui:VisualElement class="badge-container-example badge-container-circular-example">
                                    <appui:Badge name="badge-4" variant="Dot" overlap-type="Circular"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- BreadCrumbs -->
                    <appui:Heading text="BREADCRUMBS" class="example-title" />
                    <appui:Text text="Default" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Breadcrumbs>
                            <appui:BreadcrumbItem text="Home" />
                            <appui:BreadcrumbSeparator />
                            <appui:BreadcrumbItem text="Library" />
                            <appui:BreadcrumbSeparator />
                            <appui:BreadcrumbItem text="Assets" />
                            <appui:BreadcrumbSeparator />
