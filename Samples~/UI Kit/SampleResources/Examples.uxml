                        <appui:Shimmer text="Thinking" />
                    </ui:VisualElement>
                    <appui:Text text="Static" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Shimmer text="Thinking" active="false" />
                    </ui:VisualElement>

                    <!-- Skeleton -->
                    <appui:Heading text="SKELETON" class="example-title" />
                    <appui:Text text="Default" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Skeleton style="width: 240px;" />
                    </ui:VisualElement>
                    <appui:Text text="Static" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Skeleton animated="false" style="width: 240px;" />
                    </ui:VisualElement>
                    <appui:Text text="Paragraph" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Skeleton style="width: 240px; height: 12px; margin-bottom: 6px;" />
                        <appui:Skeleton style="width: 200px; height: 12px; margin-bottom: 6px;" />
                        <appui:Skeleton style="width: 160px; height: 12px;" />
                    </ui:VisualElement>
                    <appui:Text text="Media Card" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="example-row" style="align-items: flex-start;">
                            <appui:Skeleton style="width: 48px; height: 48px; margin-right: 8px;" />
                            <ui:VisualElement>
                                <appui:Skeleton style="width: 160px; height: 12px; margin-bottom: 6px;" />
                                <appui:Skeleton style="width: 120px; height: 12px;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Sidebar -->
                    <appui:Heading text="SIDEBAR" class="example-title" />
                    <appui:Text text="Sectioned app-shell navigation" class="example-subtitle" />
                    <ui:VisualElement class="example-section" style="height: 300px;">
                        <appui:Sidebar selected-id="assets" style="height: 100%;">
                            <appui:SidebarHeader>
                                <appui:Text text="My Project" />
                            </appui:SidebarHeader>
                            <appui:SidebarContent>
                                <appui:SidebarSection heading="Workspace">
                                    <appui:SidebarItem value="assets" label="Assets" icon="list" shortcut="Ctrl+1" />
                                    <appui:SidebarItem value="scenes" label="Scenes" icon="stack" shortcut="Ctrl+2" />
                                    <appui:SidebarItem value="builds" label="Builds" icon="cube" />
                                </appui:SidebarSection>
                                <appui:SidebarSection heading="Team">
                                    <appui:SidebarItem value="members" label="Members" icon="user" />
                                    <appui:SidebarItem value="activity" label="Activity" icon="bell" />
