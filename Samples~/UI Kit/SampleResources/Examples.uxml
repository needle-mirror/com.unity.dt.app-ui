                            <ui:VisualElement style="position: absolute; width: 20px; height: 20px; background-color: red;" />
                        </appui:Canvas>
                    </ui:VisualElement>
                    <appui:Text text="Editor-like controls" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Canvas style="height: 300px;" control-scheme="Editor">
                            <ui:VisualElement style="position: absolute; width: 20px; height: 20px; background-color: blue;" />
                        </appui:Canvas>
                    </ui:VisualElement>

                    <!-- Canvas Node Graph -->
                    <appui:Heading text="CANVAS NODE GRAPH" class="example-title" />
                    <appui:Text text="Nodes and edges inside a Canvas" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Canvas style="height: 300px;">
                            <appui:CanvasEdge from="130,60" to="260,140" curve-style="Bezier" is-directional="true" />
                            <appui:CanvasNode title="Entry" variant="Entry" x="20" y="20" movable="true" />
                            <appui:CanvasNode title="Idle" x="240" y="120" movable="true" />
                            <appui:CanvasNode title="Exit" variant="Exit" x="20" y="200" movable="true" />
                        </appui:Canvas>
                    </ui:VisualElement>
                    <appui:Text text="Curve styles" class="example-subtitle" />
