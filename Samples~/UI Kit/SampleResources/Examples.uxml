                                <appui:Text text="Pane 3" />
                            </appui:Pane>
                        </appui:SplitView>
                        <appui:Button name="sv-cs0b" title="Collapse Splitter 0 Backward" />
                        <appui:Button name="sv-cs1f" title="Collapse Splitter 1 Forward" />
