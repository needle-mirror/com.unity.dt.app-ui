                        <appui:SwipeView wrap="true" skip-animation-threshold="3" name="swipeview-horizontal-wrap" style="width: 200px; height: 400px;" direction="Horizontal">
                            <appui:SwipeViewItem>
                                <appui:Text text="Item 1" />
                            </appui:SwipeViewItem>
                            <appui:SwipeViewItem>
                                <appui:Text text="Item 2" />
                            </appui:SwipeViewItem>
                            <appui:SwipeViewItem>
                                <appui:Text text="Item 3" />
                            </appui:SwipeViewItem>
