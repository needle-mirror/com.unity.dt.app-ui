                            <appui:CanvasEdge from="40,90" to="240,90" curve-style="SmoothStep" is-directional="true" />
                            <appui:CanvasEdge from="40,140" to="240,140" curve-style="Step" active="true" />
                            <appui:CanvasEdge from="40,190" to="240,190" curve-style="Cable" />
                        </appui:Canvas>
