                            <appui:ActionButton name="swipeview-h-next" label="Next" />
                            <appui:ActionButton name="swipeview-h-five" label="Go to 5" />
                            <appui:ActionButton name="swipeview-h-five-snap" label="Snap to 5" />
                        </appui:ActionGroup>
