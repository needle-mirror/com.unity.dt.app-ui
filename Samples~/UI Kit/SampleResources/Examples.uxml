                    <!-- Toast -->
                    <appui:Heading text="TOAST" class="example-title" />
                    <appui:Text text="Fade Animation" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Button name="default-fade-short-toast-button" title="Default" />
                        <appui:Button name="informative-fade-short-toast-button" title="Informative" />
                        <appui:Button name="positive-fade-short-toast-button" title="Positive" />
                        <appui:Button name="warning-fade-short-toast-button" title="Warning" />
                        <appui:Button name="negative-fade-short-toast-button" title="Negative" />
                    </ui:VisualElement>
                    <appui:Text text="Slide Animation" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Button name="default-slide-short-toast-button" title="Default" />
                        <appui:Button name="informative-slide-short-toast-button" title="Informative" />
                        <appui:Button name="positive-slide-short-toast-button" title="Positive" />
                        <appui:Button name="warning-slide-short-toast-button" title="Warning" />
                        <appui:Button name="negative-slide-short-toast-button" title="Negative" />
                    </ui:VisualElement>
                    <appui:Text text="Fade - Long Duration" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Button name="default-fade-long-toast-button" title="Default" />
                    </ui:VisualElement>
                    <appui:Text text="Slide - Indefinite Duration (Actions to dismiss)" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Button name="default-slide-indef-toast-button" title="Default" />
                        <appui:Button name="informative-slide-indef-toast-button" title="Informative" />
                        <appui:Button name="positive-slide-indef-toast-button" title="Positive" />
                        <appui:Button name="warning-slide-indef-toast-button" title="Warning" />
                        <appui:Button name="negative-slide-indef-toast-button" title="Negative" />
                    </ui:VisualElement>

                    <!-- User Avatar -->
                    <appui:Heading text="USER AVATAR" class="example-title" />
                    <appui:Text text="A person, as initials on their identity colour" class="example-subtitle" />
                    <ui:VisualElement class="example-section" style="flex-direction: row; align-items: center;">
                        <appui:UserAvatar user-id="u-1" user-name="Ada Lovelace" user-color="#0A6EC8" size="Sm" tooltip="Ada Lovelace" />
                        <appui:UserAvatar user-id="u-2" user-name="Grace Hopper" user-color="#7A4FBF" size="Md" tooltip="Grace Hopper" />
                        <appui:UserAvatar user-id="u-3" user-name="Katherine Johnson" user-color="#1F8A5B" size="Lg" tooltip="Katherine Johnson" />
                        <appui:UserAvatar user-id="u-4" />
                    </ui:VisualElement>
                    <appui:Text text="Presence ring — hover to see it take the person's colour" class="example-subtitle" />
                    <ui:VisualElement class="example-section" style="flex-direction: row; align-items: center;">
                        <appui:UserAvatar user-id="u-1" user-name="Ada Lovelace" user-color="#0A6EC8" ring="true" />
                        <appui:UserAvatar user-id="u-2" user-name="Grace Hopper" user-color="#7A4FBF" ring="true" />
                        <appui:UserAvatar user-id="u-3" user-name="Katherine Johnson" user-color="#1F8A5B" ring="true" />
                    </ui:VisualElement>

                    <!-- User Switcher -->
                    <appui:Heading text="USER SWITCHER" class="example-title" />
                    <appui:Text text="Accounts are data, so the sample fills them from C#" class="example-subtitle" />
                    <ui:VisualElement class="example-section" style="flex-direction: row; align-items: center;">
                        <appui:UserSwitcher name="user-switcher" />
                        <appui:UserSwitcher name="user-switcher-named" show-name="true" />
                        <appui:UserSwitcher name="user-switcher-orgs" show-name="true" collapsible="true" section-label="Switch organization" show-account-avatars="false" />
                    </ui:VisualElement>

                    <!-- Zoomable Thumbnail -->
                    <appui:Heading text="ZOOMABLE THUMBNAIL" class="example-title" />
                    <appui:Text text="Corner control, revealed on hover or focus" class="example-subtitle" />
                    <ui:VisualElement class="example-section" style="flex-direction: row;">
                        <appui:ZoomableThumbnail name="zoomable-corner" caption="cliff-face-01.png" alt="Cliff face, tiling" style="width: 96px; height: 96px;" />
                        <appui:ZoomableThumbnail name="zoomable-empty" caption="missing.png" alt="Nothing here" style="width: 96px; height: 96px;" />
                    </ui:VisualElement>
                    <appui:Text text="Whole mode — the picture is the control" class="example-subtitle" />
                    <ui:VisualElement class="example-section" style="flex-direction: row;">
                        <appui:ZoomableThumbnail name="zoomable-whole" caption="cliff-face-01.png" alt="Cliff face, tiling" trigger-mode="Whole" style="width: 48px; height: 48px;" />
                    </ui:VisualElement>

                    <!-- Zoom Trigger Button -->
                    <appui:Heading text="ZOOM TRIGGER BUTTON" class="example-title" />
                    <appui:Text text="On its own it rests invisible; `always-visible` pins it on" class="example-subtitle" />
                    <ui:VisualElement class="example-section" style="flex-direction: row; align-items: center;">
                        <appui:ZoomTriggerButton asset-name="cliff-face-01.png" always-visible="true" />
                        <appui:ZoomTriggerButton asset-name="cliff-face-01.png" />
                    </ui:VisualElement>

                    <!-- Audio Waveform -->
                    <appui:Heading text="AUDIO WAVEFORM" class="example-title" />
                    <appui:Text text="A clip envelope. Peaks are data, so the sample fills them from C#" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:AudioWaveform name="audio-waveform" />
                    </ui:VisualElement>
                    <appui:Text text="With a playhead at 35% of the clip" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:AudioWaveform name="audio-waveform-playhead" progress="0.35" />
                    </ui:VisualElement>

                    <!-- Audio Preview -->
                    <appui:Heading text="AUDIO PREVIEW" class="example-title" />
                    <appui:Text text="A clip audition: envelope, play control and length" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:AudioPreview name="audio-preview" duration-label="0:12" style="width: 280px;" />
                    </ui:VisualElement>
                    <appui:Text text="Playing, with a playhead at 40%" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:AudioPreview name="audio-preview-playing" playing="true" progress="0.4" duration-label="0:12" style="width: 280px;" />
                    </ui:VisualElement>
                    <appui:Text text="Envelope still being computed" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:AudioPreview loading="true" style="width: 280px;" />
                    </ui:VisualElement>
                    <appui:Text text="No envelope, and the host says why" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:AudioPreview message="Clip too large to preview" duration-label="4:03" style="width: 280px;" />
                    </ui:VisualElement>
                    <appui:Text text="No envelope, named with a symbol instead" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:AudioPreview fallback-icon="music-note" duration-label="0:31" style="width: 280px;" />
                    </ui:VisualElement>

                    <!-- VU Meter -->
                    <appui:Heading text="VU METER" class="example-title" />
                    <appui:Text text="Mono, stereo, and a narrowed scale with the readout hidden" class="example-subtitle" />
                    <ui:VisualElement class="example-section" style="flex-direction: row; height: 200px;">
                        <appui:VuMeter name="vu-meter-mono" />
                        <appui:VuMeter name="vu-meter-stereo" />
                        <appui:VuMeter name="vu-meter-quiet" class="example-vu-meter--last" min="-60" max="6" show-readout="false" />
                    </ui:VisualElement>

                    <!-- Timeline -->
                    <appui:Heading text="TIMELINE" class="example-title" />
                    <appui:Text text="A dope sheet: lanes of clips and keyframes on a shared time axis" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Timeline name="timeline-dope-sheet" duration="60" px-per-unit="12" label-width="120" style="height: 172px;">
                            <appui:TimelineTrack id="position" label="Position">
                                <appui:TimelineClip start="4" duration="12" label="Walk" />
                                <appui:TimelineClip start="20" duration="8" label="Turn" />
                            </appui:TimelineTrack>
                            <appui:TimelineTrackGroup id="cube" title="Cube">
                                <appui:TimelineTrack id="rotation" label="Rotation">
                                    <appui:TimelineKeyframe time="0" />
                                    <appui:TimelineKeyframe time="12" />
                                    <appui:TimelineKeyframe time="30" draggable="true" />
                                </appui:TimelineTrack>
                                <appui:TimelineTrack id="scale" label="Scale">
                                    <appui:TimelineKeyframe time="6" shape="Circle" />
                                    <appui:TimelineKeyframe time="24" shape="Square" />
                                </appui:TimelineTrack>
                            </appui:TimelineTrackGroup>
                        </appui:Timeline>
                    </ui:VisualElement>
                    <appui:Text text="Frame clips, muted keyframes and adaptive ticks" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Timeline name="timeline-frames" duration="600" px-per-unit="2" minor-tick="5" major-tick="30" adaptive-ticks="true" max-px-per-unit="240" label-width="120" style="height: 140px;">
                            <appui:TimelineTrack id="shots" label="Shots">
                                <appui:TimelineClip start="0" duration="120" label="Establishing" frame="true" />
                                <appui:TimelineClip start="140" duration="90" label="Close-up" frame="true" frame-color="Amber" />
                                <appui:TimelineClip start="260" duration="140" label="Reaction" frame="true" frame-color="Green" />
                            </appui:TimelineTrack>
                            <appui:TimelineTrack id="cues" label="Cues">
                                <appui:TimelineKeyframe time="30" />
                                <appui:TimelineKeyframe time="150" muted="true" />
                                <appui:TimelineKeyframe time="300" muted="true" />
                                <appui:TimelineKeyframe time="480" />
                            </appui:TimelineTrack>
                        </appui:Timeline>
                    </ui:VisualElement>
                    <appui:Text text="Fitted to the viewport — the base scale fills the strip whatever the panel width" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Timeline name="timeline-fit" duration="90" fit-width="true" adaptive-ticks="true" label-width="120" style="height: 96px;">
                            <appui:TimelineTrack id="fit-track" label="Take">
                                <appui:TimelineClip start="10" duration="30" label="Segment" />
                            </appui:TimelineTrack>
                        </appui:Timeline>
                    </ui:VisualElement>
                    <appui:Text text="Editor control scheme — the wheel zooms about the cursor, Alt+drag pans" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Timeline name="timeline-editor-scheme" duration="120" px-per-unit="6" minor-tick="5" major-tick="20" control-scheme="Editor" style="height: 96px;">
                            <appui:TimelineTrack id="audio">
                                <appui:TimelineClip start="0" duration="45" label="Ambience" />
                                <appui:TimelineClip start="60" duration="30" label="Stinger" resizable="false" />
                            </appui:TimelineTrack>
                        </appui:Timeline>
                    </ui:VisualElement>

                    <!-- Toggle -->
                    <appui:Heading text="TOGGLE" class="example-title" />
                    <ui:VisualElement class="example-section">
                        <appui:Text text="Default" class="example-subtitle" />
                        <appui:Toggle label="Default" />
                        <appui:Text text="No Label" class="example-subtitle" />
                        <appui:Toggle />
                        <appui:Text text="Checked" class="example-subtitle" />
                        <appui:Toggle label="True" value="true" />
                        <appui:Text text="Emphasized And Checked" class="example-subtitle" />
                        <appui:Toggle label="True" value="true" emphasized="true" />
                        <appui:Text text="Emphasized And Unchecked" class="example-subtitle" />
                        <appui:Toggle label="False" value="false" emphasized="true" />
                        <appui:Text text="Emphasized Checked And Disabled" class="example-subtitle" />
                        <appui:Toggle label="True Disabled" value="true" emphasized="true" enabled="false" />
                        <appui:Text text="Unchecked" class="example-subtitle" />
                        <appui:Toggle label="False" value="false" />
                        <appui:Text text="Unchecked And Disabled" class="example-subtitle" />
                        <appui:Toggle label="False Disabled" value="false" enabled="false" />
                        <appui:Text text="Checked And Invalid" class="example-subtitle" />
                        <appui:Toggle label="True Invalid" value="true" class="is-invalid" />
                        <appui:Text text="Unchecked And Invalid And Disabled" class="example-subtitle" />
                        <appui:Toggle label="False Disabled Invalid" value="false" enabled="false" class="is-invalid" />
                    </ui:VisualElement>

                    <!-- Toolbar -->
                    <appui:Heading text="TOOLBAR" class="example-title" />
                    <appui:Text text="Floating" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Toolbar dock-mode="Floating">
                            <appui:ActionButton icon="info" quiet="true" />
                            <appui:ActionButton icon="info" quiet="true" />
                            <appui:Divider direction="Vertical" />
                            <appui:ActionButton icon="info" quiet="true" />
                            <appui:Divider direction="Vertical" />
                            <appui:ActionGroup quiet="true">
                                <appui:ActionButton icon="info" quiet="true" />
                                <appui:ActionButton icon="info" quiet="true" />
                                <appui:ActionButton icon="info" quiet="true" />
                            </appui:ActionGroup>
                        </appui:Toolbar>
                    </ui:VisualElement>
                    <appui:Text text="Draggable" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Toolbar draggable="true" dock-mode="Floating">
                            <appui:ActionButton icon="info" quiet="true" />
                            <appui:ActionButton icon="info" quiet="true" />
                            <appui:ActionButton icon="info" quiet="true" />
                        </appui:Toolbar>
                    </ui:VisualElement>
                    <appui:Text text="Docked Top And Bottom" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <appui:Toolbar dock-mode="Top">
                            <appui:ActionButton icon="info" quiet="true" />
                            <appui:ActionButton icon="info" quiet="true" />
                            <appui:ActionButton icon="info" quiet="true" />
                        </appui:Toolbar>
                        <appui:Toolbar dock-mode="Bottom">
                            <appui:ActionButton icon="info" quiet="true" />
                            <appui:ActionButton icon="info" quiet="true" />
                            <appui:ActionButton icon="info" quiet="true" />
                        </appui:Toolbar>
                    </ui:VisualElement>
                    <appui:Text text="Vertical" class="example-subtitle" />
                    <ui:VisualElement class="example-section" style="flex-direction: row; justify-content: space-between; align-items: flex-start;">
                        <appui:Toolbar direction="Vertical">
                            <appui:ActionButton icon="info" quiet="true" />
                            <appui:ActionButton icon="info" quiet="true" />
                            <appui:ActionButton icon="info" quiet="true" />
                        </appui:Toolbar>
                        <appui:Toolbar direction="Vertical" draggable="true">
                            <appui:ActionButton icon="info" quiet="true" />
                            <appui:ActionButton icon="info" quiet="true" />
                            <appui:ActionButton icon="info" quiet="true" />
                        </appui:Toolbar>
                        <appui:Toolbar direction="Vertical" dock-mode="Left">
                            <appui:ActionButton icon="info" quiet="true" />
                            <appui:ActionButton icon="info" quiet="true" />
                            <appui:ActionButton icon="info" quiet="true" />
                        </appui:Toolbar>
                        <appui:Toolbar direction="Vertical" dock-mode="Right">
                            <appui:ActionButton icon="info" quiet="true" />
                            <appui:ActionButton icon="info" quiet="true" />
                            <appui:ActionButton icon="info" quiet="true" />
                        </appui:Toolbar>
                    </ui:VisualElement>

                    <!-- Tooltip -->
                    <appui:Heading text="TOOLTIP" class="example-title" />
                    <ui:VisualElement class="example-section">
                        <appui:Text text="Bottom" class="example-subtitle" />
                        <appui:ActionButton label="Hover me!" tooltip="Hello i am a tooltip" />
                        <appui:Text text="End" class="example-subtitle" />
                        <appui:ActionButton label="Hover me!" tooltip="Hello i am a tooltip" preferred-tooltip-placement="End" />
                        <appui:Text text="Template And Dynamic Content" class="example-subtitle" />
                        <appui:ActionButton name="dynamic-tooltip-action-button" label="Hover me!" />
                    </ui:VisualElement>

                    <!-- TouchSlider -->
                    <appui:Heading text="TOUCHSLIDER" class="example-title" />
                    <ui:VisualElement class="example-section">
                        <appui:Text text="Default" class="example-subtitle" />
                        <appui:TouchSliderFloat label="TEMPERATURE" low-value="-100" high-value="100" value="0" format-string="#0.0°C"/>
                        <appui:Text text="Disabled" class="example-subtitle" />
                        <appui:TouchSliderFloat label="TEMPERATURE" low-value="-100" high-value="100" value="0" enabled="false" format-string="#0.0°C"/>
                        <appui:Text text="Invalid" class="example-subtitle" />
                        <appui:TouchSliderFloat label="TEMPERATURE" low-value="-100" high-value="100" value="0" class="is-invalid" format-string="#0.0°C"/>
                        <appui:Text text="Invalid And Disabled" class="example-subtitle" />
                        <appui:TouchSliderFloat label="TEMPERATURE" low-value="-100" high-value="100" value="0" class="is-invalid" enabled="false" format-string="#0.0°C"/>
                        <appui:Text text="Small" class="example-subtitle" />
                        <appui:TouchSliderFloat label="TEMPERATURE" low-value="-100" high-value="100" value="0" size="Sm" format-string="#0.0°C"/>
                        <appui:Text text="Medium" class="example-subtitle" />
                        <appui:TouchSliderFloat label="TEMPERATURE" low-value="-100" high-value="100" value="0" size="Md" format-string="#0.0°C"/>
                        <appui:Text text="Large" class="example-subtitle" />
                        <appui:TouchSliderFloat label="TEMPERATURE" low-value="-100" high-value="100" value="0" size="Lg" format-string="#0.0°C"/>
                        <appui:Text text="Vertical" class="example-subtitle" />
                        <ui:VisualElement class="example-row">
                            <ui:VisualElement class="example-item">
                                <appui:TouchSliderFloat style="height: 200px;" label="TEMPERATURE" low-value="-100" high-value="100" value="0" orientation="Vertical" format-string="#0.0°C" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- UnityLogo -->
                    <appui:Heading text="UNITYLOGO" class="example-title" />
                    <appui:Text text="Variants" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="example-row">
                            <appui:UnityLogo variant="Filled" />
                            <appui:UnityLogo variant="Empty" />
                            <appui:UnityLogo variant="Animated" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <appui:Text text="Sizes" class="example-subtitle" />
                    <ui:VisualElement class="example-section">
                        <ui:VisualElement class="example-row">
                            <appui:UnityLogo size="Xxs" />
                            <appui:UnityLogo size="Xs" />
                            <appui:UnityLogo size="Sm" />
                            <appui:UnityLogo size="Md" />
                            <appui:UnityLogo size="Lg" />
                        </ui:VisualElement>
                    </ui:VisualElement>


                </ui:VisualElement>
            </ui:ScrollView>

            <ui:VisualElement class="example-context-switcher-panel">
                <ui:ScrollView nested-interaction-kind="StopScrolling" vertical-scroller-visibility="AlwaysVisible">

                    <ui:VisualElement class="example-context-switcher-panel__content">

                        <appui:Text text="&lt;b&gt;Theme&lt;/b&gt;" enable-rich-text="true" class="example-context-switcher-panel__title" />
                        <appui:RadioGroup name="theme-switcher" class="example-context-switcher-panel__switcher" >
                            <appui:Radio key="system" label="System" emphasized="true" />
                            <appui:Radio key="dark" label="Dark" emphasized="true" value="true" />
                            <appui:Radio key="light" label="Light" emphasized="true" />
                            <appui:Radio key="editor-dark" label="Editor Dark" emphasized="true" />
                            <appui:Radio key="editor-light" label="Editor Light" emphasized="true" />
                        </appui:RadioGroup>

                        <appui:Text text="&lt;b&gt;Density&lt;/b&gt;" enable-rich-text="true" class="example-context-switcher-panel__title" />
                        <appui:RadioGroup name="density-switcher" class="example-context-switcher-panel__switcher" >
                            <appui:Radio key="normal" label="Normal" value="true" emphasized="true" />
                            <appui:Radio key="compact" label="Compact" emphasized="true" />
                            <appui:Radio key="comfort" label="Comfort" emphasized="true" />
                        </appui:RadioGroup>

                        <appui:Text text="&lt;b&gt;Direction&lt;/b&gt;" enable-rich-text="true" class="example-context-switcher-panel__title" />
                        <appui:RadioGroup name="dir-switcher" class="example-context-switcher-panel__switcher" >
                            <appui:Radio key="Ltr" label="LTR" emphasized="true" value="true" />
                            <appui:Radio key="Rtl" label="RTL" emphasized="true" />
                        </appui:RadioGroup>

                    </ui:VisualElement>

                </ui:ScrollView>

            </ui:VisualElement>

        </ui:VisualElement>

    </appui:Panel>

</ui:UXML>
