/* ColorField */
.appui-colorfield {
    border-width: var(--appui-alias-control-border-width);
    /*border-style: var(--appui-control-border-style);*/
    border-radius: var(--appui-alias-control-border-radius);
    /* The registry insets the swatch edge by calc(field-md - sizing-50) and the text edge by
       field-md. USS has no calc(), so the swatch edge reads sizing-160, the step equal to that
       difference in every density (ColorFieldTests holds the equality). */
    padding-top: 0;
    padding-bottom: 0;
    padding-left: var(--appui-sizing-160);
    padding-right: var(--appui-alias-field-padding-horizontal-md);
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    color: var(--appui-foregrounds-100);
    cursor: var(--appui-alias-control-cursor-pointer);
    flex-shrink: 0;
}

.appui--rtl .appui-colorfield {
    flex-direction: row-reverse;
    padding-left: var(--appui-alias-field-padding-horizontal-md);
    padding-right: var(--appui-sizing-160);
}

/* Two classes, after the RTL rule, so it wins in both directions. */
.appui-colorfield.appui-colorfield--swatch-only {
    padding: 0;
}

.appui-colorfield {
    background-color: var(--appui-alias-field-background-color-default);
    border-color: var(--appui-alias-field-border-color-default);
}

.appui-colorfield__color-swatch {
    display: flex;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-left: 0;
    margin-right: var(--appui-alias-control-gap-md); /*margin-inline-end: var(--appui-alias-control-gap-md);*/
}

.appui--rtl .appui-colorfield__color-swatch {
    margin-left: var(--appui-alias-control-gap-md); /*margin-inline-start: var(--appui-alias-control-gap-md);*/
    margin-right: 0;
}

.appui-colorfield--swatch-only .appui-colorfield__color-swatch {
    width: 100%;
    height: 100%;
    border-radius: var(--appui-alias-control-border-radius);
}

.appui-colorfield__label {
    color: var(--appui-foregrounds-100);
    flex: 1;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-overflow-position: end;
    /* The registry's color-field has one size, md, and reads text-base. UITK's sm steps down to
       text-sm below, since a text-base line does not fit the compact sm box. */
    font-size: var(--appui-font-sizes-200);
    -unity-text-align: middle-left;
    display: none;
    margin-left: 0;
    margin-right: var(--appui-alias-control-gap-md); /*margin-inline-end: var(--appui-alias-control-gap-md);*/
}

.appui--rtl .appui-colorfield__label {
    -unity-text-align: middle-right;
    margin-right: 0;
    margin-left: var(--appui-alias-control-gap-md); /*margin-inline-start: var(--appui-alias-control-gap-md);*/
}

.appui-colorfield--show-text .appui-colorfield__label {
    display: flex;
}

.appui-colorfield--swatch-only .appui-colorfield__label {
    display: none;
}

/*
 * The opacity readout rides the ColorField's own rim rather than drawing a second one, so the swatch,
 * the hex and the percent read as one control: no fill, no rounding, and a single hairline on its
 * leading edge to separate it from the hex. The field's own padding keeps it off the rim, since USS
 * has no calc() to negate a spacing token with.
 *
 * Width: the registry's readout is w-16, 16 x --spacing (sizing-75), 64px at Normal. No single
 * sizing step equals that in every density and USS has no calc(), so it reads sizing-1350, the
 * nearest step at Normal (65px; 54px Compact, 72px Comfort). The old lg-height (30px) left the
 * value no room at all once the field inset was added.
 */
.appui-colorfield__alpha-field {
    flex-shrink: 0;
    width: var(--appui-sizing-1350);
    background-color: var(--appui-color-transparent-black-0);
    border-top-width: 0;
    border-bottom-width: 0;
    border-right-width: 0;
    border-left-width: var(--appui-alias-control-border-width);
    border-color: var(--appui-alias-field-border-color-default);
    border-radius: 0;
    height: 100%;
}

.appui--rtl .appui-colorfield__alpha-field {
    border-left-width: 0;
    border-right-width: var(--appui-alias-control-border-width);
}

.appui-colorfield--swatch-only .appui-colorfield__alpha-field {
    display: none;
}

.appui-colorfield__color-picker-icon {
    display: flex;
    flex-shrink: 0;
}

.appui-colorfield--swatch-only .appui-colorfield__color-picker-icon {
    display: none;
}

.appui-colorfield.is-hovered {
    background-color: var(--appui-alias-field-background-color-hover);
    border-color: var(--appui-alias-field-border-color-hover);
}

.appui-colorfield.is-focused {
    background-color: var(--appui-alias-field-background-color-focus);
    border-color: var(--appui-alias-field-border-color-focus);
}

.appui-colorfield--inline-picker-opened .appui-colorfield__color-picker-icon {
    --unity-image-tint-color: var(--appui-alias-actions-accent-background-color-default);
}

.appui-colorfield.keyboard-focus {
    /* converted from : outline-width: var(--appui-alias-control-outline-width); */
    --outline-width: var(--appui-alias-control-outline-width);
    /* converted from : outline-color: var(--appui-alias-control-outline-color); */
    --outline-color: var(--appui-alias-control-outline-color);
    /* converted from : outline-offset: var(--appui-alias-control-outline-offset); */
    --outline-offset: var(--appui-alias-control-outline-offset);
    /* converted from : outline-style: var(--appui-alias-control-outline-style); */
}

.appui-colorfield.is-active {
    background-color: var(--appui-alias-field-background-color-active);
    border-color: var(--appui-alias-field-border-color-active);
}

.appui-colorfield.is-invalid {
    border-color: var(--appui-destructive-100);
}

.appui-colorfield:disabled /*.appui-colorfield.is-disabled*/ {
    background-color: var(--appui-alias-field-background-color-disabled);
    border-color: var(--appui-alias-field-border-color-disabled);
    cursor: var(--appui-alias-control-cursor-disabled);
    color: var(--appui-foregrounds-25);
}

.appui-colorfield__label:disabled /*.is-disabled > .appui-colorfield__label */{
    color: var(--appui-foregrounds-25);
}

.appui-colorfield__color-swatch:disabled /*.is-disabled > .appui-colorfield__label */{
    opacity: 0.4;
}

.appui-colorfield--size-sm {
    height: var(--appui-alias-control-sizing-sm-height);
}

.appui-colorfield--size-md {
    height: var(--appui-alias-control-sizing-md-height);
}

.appui-colorfield--size-lg {
    height: var(--appui-alias-control-sizing-lg-height);
}

/* The hex and the alpha readout step down to text-sm at sm. The alpha is an IntField that keeps its
   own Md size, so its rule has to outrank NumericalField's size rules. */
.appui-colorfield--size-sm .appui-colorfield__label,
.appui-colorfield--size-sm .appui-colorfield__label > .unity-text-field__input,
.appui-colorfield--size-sm .appui-colorfield__alpha-field .appui-numericalfield__input,
.appui-colorfield--size-sm .appui-colorfield__alpha-field .appui-numericalfield__input > .unity-text-field__input {
    font-size: var(--appui-font-sizes-100);
}
