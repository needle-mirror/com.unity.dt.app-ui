@import url("../../Icons/Icons - Minimal.uss");

/* Icon */
.appui-icon {
    --unity-image-tint-color: var(--appui-foregrounds-50); /* converted from : fill: var(--appui-foregrounds-50); */
    --unity-image-size: scale-to-fit;
    flex-shrink: 0;
}

.appui-icon--primary {
    --unity-image-tint-color: var(--appui-foregrounds-100); /* converted from : fill: var(--appui-foregrounds-100); */
}

.unity-disabled .appui-icon /* converted from : .is-disabled .appui-icon */,
.unity-disabled.appui-icon /* converted from : .is-disabled.appui-icon */ {
    --unity-image-tint-color:  var(--appui-foregrounds-25); /* converted from : fill: var(--appui-foregrounds-25); */
}

.appui-icon--size-xxs {
    width: var(--appui-alias-control-sizing-icon-xxs);
    height: var(--appui-alias-control-sizing-icon-xxs);
}

.appui-icon--size-xs {
    width: var(--appui-alias-control-sizing-icon-xs);
    height: var(--appui-alias-control-sizing-icon-xs);
}

.appui-icon--size-sm {
    width: var(--appui-alias-control-sizing-icon-sm);
    height: var(--appui-alias-control-sizing-icon-sm);
}

.appui-icon--size-md {
    width: var(--appui-alias-control-sizing-icon-md);
    height: var(--appui-alias-control-sizing-icon-md);
}

.appui-icon--size-lg {
    width: var(--appui-alias-control-sizing-icon-lg);
    height: var(--appui-alias-control-sizing-icon-lg);
}
