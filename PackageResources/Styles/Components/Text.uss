/* Text */
.appui-localized-text,
.appui-text {
  /* Nothing */ /* converted from : line-height: var(--appui-global-dimension-regular-line-height); */
  -unity-text-align: middle-left;
  flex-shrink: 0;
}

.appui--rtl .appui-text,
.appui--rtl.appui-text,
.appui--rtl .appui-localized-text,
.appui--rtl.appui-localized-text {
  -unity-text-align: middle-right;
}

/* Sizes — mirrors the registry `textVariants` size axis. The registry's
   build-registry.ts TEXT_TIERS maps xs←font-sizes-75, sm←100, base←200; the C# TextSize members keep their 2.3 names
   (XS, S, M, L, XL, XXL, XXXL); lg and up
   continue onto the steps nearest the sizes the registry renders today. Binding to
   the token vars (never to px) is what makes Text rescale with Panel.density. */

.appui-text--size-xs {
  font-size: var(--appui-font-sizes-75);
}

.appui-text--size-s {
  font-size: var(--appui-font-sizes-100);
}

.appui-text--size-m {
  font-size: var(--appui-font-sizes-200);
}

.appui-text--size-l {
  font-size: var(--appui-font-sizes-400);
}

.appui-text--size-xl {
  font-size: var(--appui-font-sizes-500);
}

.appui-text--size-xxl {
  font-size: var(--appui-font-sizes-700);
}

.appui-text--size-xxxl {
  font-size: var(--appui-font-sizes-900);
}

/* Variants — mirrors the registry's `default | secondary | muted` foreground axis,
   which maps --foreground → --appui-alias-text-primary, --foreground-secondary →
   --appui-alias-text-secondary and --foreground-muted → --appui-alias-text-disabled. */

.appui-text--default {
  color: var(--appui-alias-text-primary);
}

.appui-text--secondary {
  color: var(--appui-alias-text-secondary);
}

.appui-text--muted {
  color: var(--appui-alias-text-disabled);
}

.unity-disabled.appui-text /* converted from : .is-disabled.appui-text */,
.unity-disabled .appui-text /* converted from : .is-disabled .appui-text */,
.unity-disabled.appui-localized-text /* converted from : .is-disabled.appui-localized-text */,
.unity-disabled .appui-localized-text /* converted from : .is-disabled .appui-localized-text */ {
  color: var(--appui-alias-text-disabled);
}
