/* AssetTargetField */
.appui-assettargetfield {
    border-width: var(--appui-alias-control-border-width);
    border-radius: var(--appui-alias-control-border-radius);
    padding: 0 var(--appui-alias-control-gap-md);
    display: flex;
    flex-direction: row;
    align-items: center;
    cursor: var(--appui-alias-control-cursor-pointer);
    flex-shrink: 0;
    background-color: var(--appui-alias-field-background-color-default);
    border-color: var(--appui-alias-field-border-color-default);
}

.appui-assettargetfield__icon {
    flex-shrink: 0;
    margin-right: var(--appui-alias-control-gap-md);
    --unity-image-tint-color: var(--appui-alias-text-disabled);
}

.appui-assettargetfield__label {
    color: var(--appui-alias-text-primary);
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    /* The registry's root is text-base and its size classes carry no text class, so md and lg
       read font-sizes-200. */
    font-size: var(--appui-font-sizes-200);
}

.appui-assettargetfield__clear-button,
.appui-assettargetfield__pick-button {
    flex-shrink: 0;
    margin-left: var(--appui-alias-control-gap-md);
}

.appui-assettargetfield.keyboard-focus {
    background-color: var(--appui-alias-field-background-color-focus);
    border-color: var(--appui-alias-field-border-color-focus);
    /* converted from : outline-width: var(--appui-alias-control-outline-width); */
    --outline-width: var(--appui-alias-control-outline-width);
    /* converted from : outline-color: var(--appui-alias-control-outline-color); */
    --outline-color: var(--appui-alias-control-outline-color);
    /* converted from : outline-offset: var(--appui-alias-control-outline-offset); */
    --outline-offset: var(--appui-alias-control-outline-offset);
}

.appui-assettargetfield.is-hovered {
    background-color: var(--appui-alias-field-background-color-hover);
    border-color: var(--appui-alias-control-border-color-hover);
}

.appui-assettargetfield.is-active {
    background-color: var(--appui-alias-field-background-color-active);
    border-color: var(--appui-alias-field-border-color-active);
}

.appui-assettargetfield.is-invalid {
    border-color: var(--appui-alias-field-border-color-invalid);
}

.appui-assettargetfield:disabled {
    background-color: var(--appui-alias-field-background-color-disabled);
    border-color: var(--appui-alias-field-border-color-disabled);
    cursor: var(--appui-alias-control-cursor-disabled);
}

.appui-assettargetfield__label:disabled {
    color: var(--appui-alias-text-disabled);
}

.appui-assettargetfield__icon:disabled {
    --unity-image-tint-color: var(--appui-alias-text-disabled);
}

.appui-assettargetfield--size-sm {
    height: var(--appui-alias-control-sizing-sm-height);
}

.appui-assettargetfield--size-md {
    height: var(--appui-alias-control-sizing-md-height);
}

.appui-assettargetfield--size-lg {
    height: var(--appui-alias-control-sizing-lg-height);
}

/* The registry keeps text-base at sm too, but a text-base line does not fit the compact sm box,
   so UITK deliberately steps sm down to text-sm. After the size rules, so their own selector
   stays the first rule that starts with it. */
.appui-assettargetfield--size-sm .appui-assettargetfield__label {
    font-size: var(--appui-font-sizes-100);
}
