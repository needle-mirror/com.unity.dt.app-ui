/* NumericalField */
.appui-numericalfield {
    background-color: var(--appui-alias-field-background-color-default);
    display: flex;
    flex-direction: row;
    align-items: center;
    border-radius: var(--appui-alias-control-border-radius);
    border-width: var(--appui-alias-control-border-width);
    /*border-style: var(--appui-control-border-style);*/
    border-color: var(--appui-alias-field-border-color-default);
    /* Horizontal inset: the size rules read --appui-alias-field-padding-horizontal-*, as the
       registry's fields do. */
    padding: 0;
    cursor: var(--appui-alias-control-cursor-text);
    flex-shrink: 0;
}

.appui--rtl .appui-numericalfield {
    flex-direction: row-reverse;
}

.appui-numericalfield--size-sm {
    height: var(--appui-alias-control-sizing-sm-height);
    padding-left: var(--appui-alias-field-padding-horizontal-sm);
    padding-right: var(--appui-alias-field-padding-horizontal-sm);
}

.appui-numericalfield--size-md {
    height: var(--appui-alias-control-sizing-md-height);
    padding-left: var(--appui-alias-field-padding-horizontal-md);
    padding-right: var(--appui-alias-field-padding-horizontal-md);
}

.appui-numericalfield--size-lg {
    height: var(--appui-alias-control-sizing-lg-height);
    padding-left: var(--appui-alias-field-padding-horizontal-lg);
    padding-right: var(--appui-alias-field-padding-horizontal-lg);
}

.appui-numericalfield:hover,
.appui-inputlabel:hover > .appui-numericalfield {
    background-color: var(--appui-alias-field-background-color-hover);
    border-color: var(--appui-alias-field-border-color-hover);
}

.appui-numericalfield:hover .appui-numericalfield__input,
.appui-inputlabel:hover .appui-numericalfield__input {
    color: var(--appui-foregrounds-100);
}

.appui-numericalfield.is-focused,
.appui-inputlabel:hover > .appui-numericalfield.is-focused {
    background-color: var(--appui-alias-field-background-color-focus);
    border-color: var(--appui-alias-field-border-color-focus);
}

.appui-numericalfield.keyboard-focus {
    /* converted from : outline-width: var(--appui-alias-control-outline-width); */
    --outline-width: var(--appui-alias-control-outline-width);
    /* converted from : outline-color: var(--appui-alias-control-outline-color); */
    --outline-color: var(--appui-alias-control-outline-color);
    /* converted from : outline-offset: var(--appui-alias-control-outline-offset); */
    --outline-offset: var(--appui-alias-control-outline-offset);
    /* converted from : outline-style: var(--appui-alias-control-outline-style); */
}

.appui-numericalfield:active {
    background-color: var(--appui-alias-field-background-color-active);
    border-color: var(--appui-alias-field-border-color-active);
    color: var(--appui-foregrounds-200);
}

.appui-numericalfield:disabled /*.appui-numericalfield.is-disabled*/,
.appui-inputlabel:hover > .appui-numericalfield:disabled /*.appui-inputlabel:hover .appui-numericalfield.is-disabled*/ {
    border-color: var(--appui-alias-field-border-color-disabled);
    background-color: var(--appui-alias-field-background-color-disabled);
}

.appui-numericalfield__inputcontainer {
    flex-grow: 1;
    height: 100%;
}

.appui-numericalfield__input {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    /*outline: none;*/
    color: var(--appui-foregrounds-50);
    /*text-indent: 0;*/
    width: 100%;
    cursor: var(--appui-alias-control-cursor-text);
    height: 100%;
    margin: 0;
}

.appui-numericalfield__input,
.appui-numericalfield__input > .unity-text-field__input {
    -unity-text-align: middle-left;
}

.appui--rtl .appui-numericalfield__input,
.appui--rtl .appui-numericalfield__input > .unity-text-field__input {
    -unity-text-align: middle-right;
}

.appui-numericalfield:disabled .appui-numericalfield__input /*.appui-numericalfield.is-disabled .appui-numericalfield__input*/ {
    color: var(--appui-foregrounds-25);
    cursor: var(--appui-alias-control-cursor-disabled);
}

.appui-numericalfield:disabled /*.appui-numericalfield.is-disabled*/ {
    cursor: var(--appui-alias-control-cursor-disabled);
}

.appui-numericalfield__trailingcontainer {
    flex-shrink: 0;
    margin-left: var(--appui-alias-control-gap-md); /*margin-inline-start: var(--appui-alias-control-gap-md);*/
    margin-right: 0;
}

.appui--rtl .appui-numericalfield__trailingcontainer {
    margin-left: 0;
    margin-right: var(--appui-alias-control-gap-md); /*margin-inline-end: var(--appui-alias-control-gap-md);*/
}

.appui-numericalfield__unit {
    /* The registry's suffix is text-sm at every size, smaller than the value from md up. */
    font-size: var(--appui-font-sizes-100);
    color: var(--appui-foregrounds-50);
    cursor: var(--appui-alias-control-cursor-ewresize);
}

/* The value takes the registry's absolute steps: text-sm (font-sizes-100) at sm and
   text-base (font-sizes-200) at md and lg. */
.appui-numericalfield--size-sm .appui-numericalfield__input,
.appui-numericalfield--size-sm .appui-numericalfield__input > .unity-text-field__input {
    font-size: var(--appui-font-sizes-100);
}

.appui-numericalfield--size-md .appui-numericalfield__input,
.appui-numericalfield--size-md .appui-numericalfield__input > .unity-text-field__input {
    font-size: var(--appui-font-sizes-200);
}

.appui-numericalfield--size-lg .appui-numericalfield__input,
.appui-numericalfield--size-lg .appui-numericalfield__input > .unity-text-field__input {
    font-size: var(--appui-font-sizes-200);
}

.appui-numericalfield:disabled .appui-numericalfield__unit  /*.appui-numericalfield.is-disabled .appui-numericalfield__unit */{
    color: var(--appui-foregrounds-25);
}

.appui-numericalfield.is-invalid {
    border-color: var(--appui-alias-field-border-color-invalid);
}

.appui-numericalfield.is-invalid:disabled {
    border-color: var(--appui-destructive-25);
}
