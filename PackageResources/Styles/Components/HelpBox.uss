/* HelpBox */

.appui-helpbox {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: var(--appui-sizing-200); /* p-[sizing-200] in the registry */
    border-radius: var(--appui-alias-control-border-radius);
    border-width: var(--appui-alias-control-border-width);
    border-color: var(--appui-foregrounds-25);
    background-color: var(--appui-backgrounds-100);
}

.appui--rtl .appui-helpbox {
    flex-direction: row-reverse;
}

/* Semantic variants */

.appui-helpbox--default {
    border-color: var(--appui-foregrounds-25);
}

.appui-helpbox--confirmation {
    border-color: var(--appui-alias-semantic-positive);
}

.appui-helpbox--information {
    border-color: var(--appui-alias-semantic-informative);
}

.appui-helpbox--destructive {
    border-color: var(--appui-alias-semantic-destructive);
}

.appui-helpbox--error {
    border-color: var(--appui-alias-semantic-destructive);
}

.appui-helpbox--warning {
    border-color: var(--appui-alias-semantic-warning);
}

/* Icon */

.appui-helpbox__icon {
    flex-shrink: 0;
    margin-right: var(--appui-sizing-160); /* gap-2 in the registry */
    margin-left: 0;
    align-self: flex-start;
    --unity-image-tint-color: var(--appui-foregrounds-100);
}

.appui--rtl .appui-helpbox__icon {
    margin-right: 0;
    margin-left: var(--appui-sizing-160);
}

/* The registry's glyph is one step below the box size (icon-sm at md). Icon.uss is imported
   after this file, so these outrank its `.appui-icon--size-*` class with an extra selector. */
.appui-helpbox--size-sm > .appui-icon.appui-helpbox__icon {
    width: var(--appui-alias-control-sizing-icon-xs);
    height: var(--appui-alias-control-sizing-icon-xs);
}

.appui-helpbox--size-md > .appui-icon.appui-helpbox__icon {
    width: var(--appui-alias-control-sizing-icon-sm);
    height: var(--appui-alias-control-sizing-icon-sm);
}

.appui-helpbox--size-lg > .appui-icon.appui-helpbox__icon {
    width: var(--appui-alias-control-sizing-icon-md);
    height: var(--appui-alias-control-sizing-icon-md);
}

.appui-helpbox--confirmation > .appui-helpbox__icon {
    --unity-image-tint-color: var(--appui-alias-semantic-positive);
}

.appui-helpbox--information > .appui-helpbox__icon {
    --unity-image-tint-color: var(--appui-alias-semantic-informative);
}

.appui-helpbox--destructive > .appui-helpbox__icon {
    --unity-image-tint-color: var(--appui-alias-semantic-destructive);
}

.appui-helpbox--error > .appui-helpbox__icon {
    --unity-image-tint-color: var(--appui-alias-semantic-destructive);
}

.appui-helpbox--warning > .appui-helpbox__icon {
    --unity-image-tint-color: var(--appui-alias-semantic-warning);
}

/* Message */

.appui-helpbox__message {
    flex-shrink: 1;
    flex-grow: 1;
    font-size: var(--appui-font-sizes-200);
    white-space: normal;
    color: var(--appui-foregrounds-100);
    -unity-text-align: middle-left;
}

.appui--rtl .appui-helpbox__message {
    -unity-text-align: middle-right;
}

.appui-helpbox--size-sm > .appui-helpbox__message {
    font-size: var(--appui-font-sizes-100);
}

.appui-helpbox--size-md > .appui-helpbox__message {
    font-size: var(--appui-font-sizes-200);
}

.appui-helpbox--size-lg > .appui-helpbox__message {
    font-size: var(--appui-font-sizes-300);
}
