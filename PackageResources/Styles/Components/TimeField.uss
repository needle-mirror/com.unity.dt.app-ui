/* TimeField */
.appui-time-field {
    border-width: var(--appui-alias-control-border-width);
    border-radius: var(--appui-alias-control-border-radius);
    padding: 0 var(--appui-alias-control-gap-md);
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    color: var(--appui-foregrounds-100);
    width: 100%;
    flex-shrink: 0;
    background-color: var(--appui-base-100);
    border-color: var(--appui-base-400);
}

.appui--rtl .appui-time-field {
    flex-direction: row-reverse;
}

.appui-time-field__input {
    color: var(--appui-foregrounds-100);
    flex-grow: 1;
    flex-shrink: 1;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-overflow-position: end;
    -unity-text-align: middle-left;
    padding-right: var(--appui-alias-control-gap-md);
    padding-left: 0;
    margin: 0;
}

.appui-time-field__input > .unity-text-field__input {
    flex-grow: 1;
    flex-shrink: 0;
}

.appui-time-field__input > .unity-text-field__input > .unity-text-element {
    flex-grow: 0;
    flex-shrink: 0;
}

.appui--rtl .appui-time-field__input {
    -unity-text-align: middle-right;
    padding-right: 0;
    padding-left: var(--appui-alias-control-gap-md);
}

.appui-time-field__picker-button {
    height: var(--appui-alias-control-sizing-sm-square);
    width: var(--appui-alias-control-sizing-sm-square);
    padding: var(--appui-alias-control-gap-sm);
    border-radius: var(--appui-alias-control-border-radius);
    cursor: var(--appui-alias-control-cursor-pointer);
    flex-shrink: 0;
    flex-grow: 0;
}

.appui-time-field__picker-button.is-hovered,
.appui-time-field__picker-button:focus,
.appui-time-field__picker-button:active {
    background-color: var(--appui-alias-actions-background-color-active);
}

.appui-time-field__picker-button > .appui-icon {
    width: 100%;
    height: 100%;
}

.appui-time-field__picker-button.is-hovered > .appui-icon,
.appui-time-field__picker-button.is-focused > .appui-icon,
.appui-time-field__picker-button.is-active > .appui-icon {
    -unity-background-image-tint-color: var(--appui-alias-actions-foreground-color-active);
    color: var(--appui-alias-actions-foreground-color-active);
}

.appui-time-field.is-hovered {
    background-color: var(--appui-base-200);
    border-color: var(--appui-base-500);
}

.appui-time-field.is-focused {
    background-color: var(--appui-base-50);
    border-color: var(--appui-accent-100);
}

.appui-time-field.keyboard-focus {
    --outline-width: var(--appui-alias-control-outline-width);
    --outline-color: var(--appui-alias-control-outline-color);
    --outline-offset: var(--appui-alias-control-outline-offset);
}

.appui-time-field.is-active {
    background-color: var(--appui-base-50);
    border-color: var(--appui-base-500);
}

.appui-time-field.is-invalid {
    border-color: var(--appui-destructive-100);
}

.appui-time-field:disabled {
    background-color: var(--appui-base-100);
    border-color: var(--appui-base-400);
    cursor: var(--appui-alias-control-cursor-disabled);
    color: var(--appui-foregrounds-25);
}

.appui-time-field__input:disabled {
    color: var(--appui-foregrounds-25);
}

.appui-time-field--size-sm {
    height: var(--appui-alias-control-sizing-sm-height);
}

.appui-time-field--size-md {
    height: var(--appui-alias-control-sizing-md-height);
}

.appui-time-field--size-lg {
    height: var(--appui-alias-control-sizing-lg-height);
}

/* The value takes the registry's text-field steps: text-sm (font-sizes-100) at sm and
   text-base (font-sizes-200) at md and lg. */

.appui-time-field--size-sm .appui-time-field__input,
.appui-time-field--size-sm .appui-time-field__input > .unity-text-field__input {
    font-size: var(--appui-font-sizes-100);
}

.appui-time-field--size-md .appui-time-field__input,
.appui-time-field--size-md .appui-time-field__input > .unity-text-field__input {
    font-size: var(--appui-font-sizes-200);
}

.appui-time-field--size-lg .appui-time-field__input,
.appui-time-field--size-lg .appui-time-field__input > .unity-text-field__input {
    font-size: var(--appui-font-sizes-200);
}
