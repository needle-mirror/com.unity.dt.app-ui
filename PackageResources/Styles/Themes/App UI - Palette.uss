  --appui-color-transparent-white-700: rgba(255, 255, 255, 0.7);
  --appui-color-transparent-white-800: rgba(255, 255, 255, 0.8);
  --appui-color-transparent-white-900: rgba(255, 255, 255, 0.9);
  --appui-color-transparent-white-1000: #ffffff;
}
